    <script>
        function loadOrders() {

            document.getElementById("orderData").innerHTML =
                "<div class='loading'>Loading products...</div>";

            var xhttp = new XMLHttpRequest();

            xhttp.onreadystatechange = function () {

                if (this.readyState == 4 && this.status == 200) {

                    var xml = this.responseXML;

                    var orders = xml.getElementsByTagName("order");

                    var output = "";

                    output += "<h2 style='text-align:center;'>🛒 Shopping Products</h2>";

                    output += "<table>";

                    output += "<tr>";
                    output += "<th>ID</th>";
                    output += "<th>Customer</th>";
                    output += "<th>Product</th>";
                    output += "<th>Quantity</th>";
                    output += "<th>Price</th>";
                    output += "</tr>";

                    for (var i = 0; i < orders.length; i++) {

                        var o = orders[i];

                        function val(tag) {
                            return o.getElementsByTagName(tag)[0]
                                .childNodes[0].nodeValue;
                        }

                        var id = val("id");
                        var customer = val("customer");
                        var product = val("product");
                        var quantity = val("quantity");
                        var price = val("price");

                        output += "<tr>";

                        output += "<td>" + id + "</td>";
                        output += "<td>" + customer + "</td>";
                        output += "<td>" + product + "</td>";

                        output += "<td class='quantity'>";
                        output += quantity;
                        output += "</td>";

                        output += "<td class='price'>₹" + price + "</td>";

                        output += "</tr>";
                    }

                    output += "</table>";

                    document.getElementById("orderData").innerHTML = output;
                }

                else if (this.readyState == 4) {

                    document.getElementById("orderData").innerHTML =
                        "<div class='loading'>❌ Unable to load orders.xml</div>";
                }
        }
    </script>

</head>

