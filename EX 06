                    "<td>" + paymentMethod + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Total Amount</b></td>" +

                    "<td>Rs. " +

                    totalAmount +

                    "</td>" +

                    "</tr>"

            );

            out.println("</table>");

            out.println(

                    "<h2>All Stored Ticket Records</h2>"

            );

            out.println("<table>");

            out.println(

                    "<tr>" +

                    "<th>ID</th>" +

                    "<th>Name</th>" +

                    "<th>Email</th>" +

                    "<th>Phone</th>" +

                    "<th>Event</th>" +

                    "<th>Date</th>" +

                    "<th>Type</th>" +

                    "<th>Count</th>" +

                    "<th>Seat</th>" +

                    "<th>Payment</th>" +

                    "<th>Total</th>" +

                    "<th>Booking Time</th>" +

                    "</tr>"

            );

            String selectSQL =

                    "SELECT * FROM TICKETS " +

                    "ORDER BY TICKET_ID DESC";

            PreparedStatement selectPS =

                    con.prepareStatement(selectSQL);

            ResultSet rs =

                    selectPS.executeQuery();

            while (rs.next()) {

                int id =

                        rs.getInt("TICKET_ID");

                String name =

                        rs.getString("USERNAME");

                String dbEmail =

                        rs.getString("EMAIL");

                String dbPhone =

                        rs.getString("PHONE");

                String dbEvent =

                        rs.getString("EVENT_NAME");

                Date dbDate =

                        rs.getDate("EVENT_DATE");

                String dbType =

                        rs.getString("TICKET_TYPE");

                int count =

                        rs.getInt("NUM_TICKETS");

                String dbSeat =

                        rs.getString("SEAT_PREFERENCE");

                String dbPayment =

                        rs.getString("PAYMENT_METHOD");

                double dbTotal =

                        rs.getDouble("TOTAL_AMOUNT");

                Timestamp dbBookingTime =

                        rs.getTimestamp("BOOKING_TIME");

                out.println("<tr>");

                out.println(

                        "<td>" + id + "</td>"

                );

                out.println(

                        "<td>" + name + "</td>"

                );

                out.println(

                        "<td>" + dbEmail + "</td>"

                );

                out.println(

                        "<td>" + dbPhone + "</td>"

                );

                out.println(

                        "<td>" + dbEvent + "</td>"

                );

                out.println(

                        "<td>" + dbDate + "</td>"

                );

                out.println(

                        "<td>" + dbType + "</td>"

                );

                out.println(

                        "<td>" + count + "</td>"

                );

                out.println(

                        "<td>" + dbSeat + "</td>"

                );

                out.println(

                        "<td>" + dbPayment + "</td>"

                );

                out.println(

                        "<td>Rs. " + dbTotal + "</td>"

                );

                out.println(

                        "<td>" + dbBookingTime + "</td>"

                );

                out.println("</tr>");

            }

            rs.close();

            selectPS.close();

            con.close();

            out.println(

                    "</table>"

            );

            out.println(

                    "<a class='button' " +

                    "href='index.html'>" +

                    "Book Another Ticket" +

                    "</a>"

            );

            out.println("</div>");

            out.println("</body>");

            out.println("</html>");

        } catch (Exception e) {

            out.println(

                    "<h2>Error Occurred</h2>"

            );

            out.println(

                    "<pre>"

            );

            e.printStackTrace(out);

            out.println(

                    "</pre>"

            );

        }

    }

}
