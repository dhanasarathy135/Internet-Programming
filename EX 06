import java.io.IOException;

import java.io.PrintWriter;

import java.sql.Connection;

import java.sql.Date;

import java.sql.DriverManager;

import java.sql.PreparedStatement;

import java.sql.ResultSet;

import java.sql.Timestamp;

import javax.servlet.ServletException;

import javax.servlet.annotation.WebServlet;

import javax.servlet.http.HttpServlet;

import javax.servlet.http.HttpServletRequest;

import javax.servlet.http.HttpServletResponse;

@WebServlet("/TicketServlet")

public class TicketServlet extends HttpServlet {

    private static final String DB_URL =

            "jdbc:derby://localhost:1527/TicketDB";

    private static final String DB_USER = "app";

    private static final String DB_PASSWORD = "app";

    @Override

    protected void doPost(HttpServletRequest request,

                          HttpServletResponse response)

            throws ServletException, IOException {

        response.setContentType("text/html;charset=UTF-8");

        PrintWriter out = response.getWriter();

        try {

            String userName = request.getParameter("userName");

            String email = request.getParameter("email");

            String phone = request.getParameter("phone");

            String eventName = request.getParameter("eventName");

            Date eventDate =

                    Date.valueOf(request.getParameter("eventDate"));

            String ticketType =

                    request.getParameter("ticketType");

            int numTickets =

                    Integer.parseInt(request.getParameter("numTickets"));

            String seatPreference =

                    request.getParameter("seatPreference");

            String paymentMethod =

                    request.getParameter("paymentMethod");

            double ticketPrice;

            switch (ticketType) {

                case "Regular":

                    ticketPrice = 200;

                    break;

                case "Student":

                    ticketPrice = 250;

                    break;

                case "VIP":

                    ticketPrice = 500;

                    break;

                default:

                    ticketPrice = 0;

                    break;

            }

            double totalAmount =

                    ticketPrice * numTickets;

            Class.forName(

                    "org.apache.derby.jdbc.ClientDriver"

            );

            Connection con =

                    DriverManager.getConnection(

                            DB_URL,

                            DB_USER,

                            DB_PASSWORD

                    );

            String insertSQL =

                    "INSERT INTO TICKETS "

                    + "(USERNAME, EMAIL, PHONE, EVENT_NAME, "

                    + "EVENT_DATE, TICKET_TYPE, NUM_TICKETS, "

                    + "SEAT_PREFERENCE, PAYMENT_METHOD, "

                    + "TOTAL_AMOUNT, BOOKING_TIME) "

                    + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

            PreparedStatement ps =

                    con.prepareStatement(

                            insertSQL,

                            java.sql.Statement.RETURN_GENERATED_KEYS

                    );

            ps.setString(1, userName);

            ps.setString(2, email);

            ps.setString(3, phone);

            ps.setString(4, eventName);

            ps.setDate(5, eventDate);

            ps.setString(6, ticketType);

            ps.setInt(7, numTickets);

            ps.setString(8, seatPreference);

            ps.setString(9, paymentMethod);

            ps.setDouble(10, totalAmount);

            Timestamp bookingTime =

                    new Timestamp(System.currentTimeMillis());

            ps.setTimestamp(11, bookingTime);

            ps.executeUpdate();

            int ticketId = 0;

            ResultSet generatedKeys =

                    ps.getGeneratedKeys();

            if (generatedKeys.next()) {

                ticketId =

                        generatedKeys.getInt(1);

            }

            generatedKeys.close();

            ps.close();

            out.println("<!DOCTYPE html>");

            out.println("<html>");

            out.println("<head>");

            out.println("<meta charset='UTF-8'>");

            out.println("<title>Ticket Booking System</title>");

            out.println("<style>");

            out.println(

                    "body{" +

                    "font-family:Arial,sans-serif;" +

                    "background-color:#f2f2f2;" +

                    "}"

            );

            out.println(

                    ".container{" +

                    "width:95%;" +

                    "margin:30px auto;" +

                    "background:white;" +

                    "padding:25px;" +

                    "border-radius:10px;" +

                    "}"

            );

            out.println(

                    "h1,h2{" +

                    "text-align:center;" +

                    "}"

            );

            out.println(

                    ".success{" +

                    "text-align:center;" +

                    "font-size:22px;" +

                    "color:green;" +

                    "font-weight:bold;" +

                    "}"

            );

            out.println(

                    ".details{" +

                    "width:500px;" +

                    "margin:20px auto;" +

                    "border-collapse:collapse;" +

                    "}"

            );

            out.println(

                    ".details td{" +

                    "border:1px solid #999;" +

                    "padding:8px;" +

                    "text-align:center;" +

                    "}"

            );

            out.println(

                    "table{" +

                    "width:100%;" +

                    "border-collapse:collapse;" +

                    "margin-top:20px;" +

                    "}"

            );

            out.println(

                    "th,td{" +

                    "border:1px solid #999;" +

                    "padding:8px;" +

                    "text-align:center;" +

                    "}"

            );

            out.println(

                    "th{" +

                    "background:#ddd;" +

                    "}"

            );

            out.println(

                    ".button{" +

                    "display:block;" +

                    "width:200px;" +

                    "margin:20px auto;" +

                    "padding:10px;" +

                    "text-align:center;" +

                    "background:#333;" +

                    "color:white;" +

                    "text-decoration:none;" +

                    "}"

            );

            out.println(

                    ".button:hover{" +

                    "background:#555;" +

                    "}"

            );

            out.println("</style>");

            out.println("</head>");

            out.println("<body>");

            out.println("<div class='container'>");

            out.println(

                    "<div class='success'>" +

                    "Ticket Booked Successfully" +

                    "</div>"

            );

            out.println(

                    "<h2>Your Ticket Details</h2>"

            );

            out.println(

                    "<table class='details'>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Ticket ID</b></td>" +

                    "<td>" + ticketId + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Name</b></td>" +

                    "<td>" + userName + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Email</b></td>" +

                    "<td>" + email + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Phone</b></td>" +

                    "<td>" + phone + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Event</b></td>" +

                    "<td>" + eventName + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Event Date</b></td>" +

                    "<td>" + eventDate + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Ticket Type</b></td>" +

                    "<td>" + ticketType + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Number of Tickets</b></td>" +

                    "<td>" + numTickets + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

                    "<td><b>Seat Preference</b></td>" +

                    "<td>" + seatPreference + "</td>" +

                    "</tr>"

            );

            out.println(

                    "<tr>" +

