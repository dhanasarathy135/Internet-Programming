<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EX05</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            --card-bg: #ffffff;
            --text-main: #1f2937;
            --text-muted: #4b5563;
            --border-color: #e5e7eb;
            --accent-glow: rgba(79, 70, 229, 0.15);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            margin: 0;
            padding: 40px 20px;
            color: var(--text-main);
        }

        form {
            max-width: 700px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .form-header {
            text-align: center;
            margin-bottom: 35px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 20px;
        }

        h2 {
            color: var(--primary);
            font-size: 28px;
            margin: 0 0 10px 0;
            letter-spacing: -0.5px;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0;
        }

        .question-block {
            background: #fafafa;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .question-block:hover {
            border-color: var(--primary);
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .question-block p {
            margin-top: 0;
            margin-bottom: 15px;
            font-size: 16px;
            color: var(--text-main);
        }

        .user-info-block {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 25px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
        }

        label.user-label {
            font-weight: 600;
            color: #166534;
            margin-bottom: 8px;
            display: block;
        }

        input[type="text"] {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 15px;
            outline: none;
            transition: all 0.2s ease;
            background: #fff;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        .options-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .question-block label {
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            transition: all 0.2s ease;
            margin-bottom: 0;
        }

        .question-block label:hover {
            background: #f3f4f6;
            border-color: #d1d5db;
        }

        input[type="radio"] {
            accent-color: var(--primary);
            margin-right: 12px;
            transform: scale(1.1);
        }

        input[type="submit"] {
            background-color: var(--primary);
            color: white;
            padding: 14px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease, transform 0.1s ease;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            margin-top: 10px;
        }

        input[type="submit"]:hover {
            background-color: var(--primary-hover);
        }

        input[type="submit"]:active {
            transform: scale(0.99);
        }
    </style>
</head>
